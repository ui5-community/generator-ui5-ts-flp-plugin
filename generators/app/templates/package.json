{
  "name": "<%= namespace %>",
  "version": "1.0.0",
  "description": "Fiori Plugin: <%= namespace %>",
  "author": "<%= author %>",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "ui5 build --clean-dest",
    "build:opt": "ui5 build self-contained --clean-dest --all",
    "start": "ui5 serve --port 8080 --config ui5-test.yaml -o test/flpSandbox.html",
    "ts-typecheck": "tsc --noEmit",
    "lint": "eslint webapp",
    "ui5lint": "ui5lint",
    "test": "npm run lint && npm run ts-typecheck && npm run ui5lint"
  },
  "devDependencies": {
    "<%= tstypes %>": "<%= tstypesVersion %>",
    "@eslint/js": "^10.0.1",
    "@ui5/cli": "^4.0.71",
    "@ui5/linter": "^1.23.7",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "ui5-middleware-livereload": "^3.4.0",
    "ui5-tooling-transpile": "^3.13.1"
  }
}
